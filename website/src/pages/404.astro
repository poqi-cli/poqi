---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found — poqi"
  description="The requested poqi website page could not be found."
  noindex
>
  <SiteHeader />
  <main id="main" class="not-found wrap">
    <div class="eyebrow">404 / PAGE NOT FOUND</div>
    <h1>That query<br /> returned <span class="last-word">nothing<span class="period">.</span></span></h1>
    <p>The page may have moved, or the address may be incomplete.</p>
    <a class="button blue" href={base}>Return to poqi <span aria-hidden="true">↗</span></a>
  </main>
  <SiteFooter />
</BaseLayout>
