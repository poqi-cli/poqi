---
interface Props {
  clip: string;
  label: string;
  description: string;
  duration: number;
}
const { clip, label, description, duration } = Astro.props;
const media = `${import.meta.env.BASE_URL}demos/${clip}`;
---

<figure class="demo-video">
  <video controls muted playsinline preload="none" loading="lazy" width="1044" height="608"
    poster={`${media}-poster.webp`} aria-label={label} aria-describedby={`demo-${clip}`}>
    <source src={`${media}.webm`} type="video/webm" />
    <source src={`${media}.mp4`} type="video/mp4" />
    <a href={`${media}.mp4`}>Watch {label}</a>
  </video>
  <figcaption id={`demo-${clip}`}>
    <span>{description} <span class="demo-duration">{duration}s · silent</span></span>
    <a href={`${media}.mp4`} target="_blank" rel="noopener" aria-label={`Open ${label} full size`}>Full size ↗</a>
  </figcaption>
</figure>
